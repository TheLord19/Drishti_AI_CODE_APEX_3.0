# =============================================================================
# DRISHTI AI — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to the repository.
# =============================================================================

# --- LLM Provider ---
LLM_PROVIDER=groq                       # groq | openai | anthropic
LLM_MODEL=openai/gpt-oss-120b           # primary model (Groq ultra-fast LPU)
GROQ_API_KEY=gsk_your_key_here          # REQUIRED for Groq — never commit this
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=openai/gpt-oss-20b   # secondary / fallback model
LLM_MODE=live                           # live | cache | replay

# --- Database ---
MONGODB_URI=mongodb://mongo:27017/drishti

# --- Artifacts ---
ARTIFACT_DIR=/data/artifacts

# --- Security ---
OPERATOR_PRIVATE_ALLOWLIST=shoplite      # hosts allowed despite private addresses

# --- ShopLite ---
# docker-compose maps these. Running ShopLite directly with node, use PORT and BUG_SET instead.
SHOPLITE_BUG_SET=all                     # all | none | B1,B2,B3 (comma-separated)
SHOPLITE_PORT=3001

# --- Runner ---
MAX_PARALLEL_CONTEXTS=1                  # 1 for MVP (sequential)

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Backend ---
BACKEND_PORT=8000
